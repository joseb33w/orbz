# Supabase project URL — used by the in-browser supabase-js client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (publishable) key — safe to expose in the browser.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Per-user table prefix used by Orbz to scope the global leaderboard
# table inside Gogi's shared Supabase project. Match the prefix from
# your Gogi cloud-agent context (e.g. usr_xxxxxxxxxxxx).
VITE_TABLE_PREFIX=your_table_prefix
